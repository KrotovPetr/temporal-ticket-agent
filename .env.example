TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ticket-autopilot

POLL_INTERVAL_MS=10000

# http | configurable-http
TRACKER_PROVIDER=http
TRACKER_BASE_URL=http://localhost:4000
TRACKER_API_KEY=

# Used when TRACKER_PROVIDER=configurable-http
TRACKER_CONFIG_PATH=tracker.demo.config.json

# Yandex Tracker envs for tracker.yandex.config.json
YANDEX_TRACKER_TOKEN=
YANDEX_TRACKER_ORG_ID=
YANDEX_TRACKER_QUEUE=

# mock | universal
LLM_PROVIDER=mock

# chat-completions | responses | responses-raw
LLM_API_STYLE=chat-completions

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional prompt/agent id for providers that support Responses API prompts.
LLM_PROMPT_ID=

# Extra headers as JSON object.
# Example:
# LLM_HEADERS_JSON={"OpenAI-Project":"project-id"}
LLM_HEADERS_JSON={}

MIN_CONFIDENCE=0.75
ALLOWED_CATEGORIES=docs,test,bugfix,config
FORBIDDEN_KEYWORDS=auth,security,payment,billing,permission,database migration,infrastructure,secrets,encryption,compliance

DEMO_TRACKER_PORT=4000
